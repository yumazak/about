---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Yuma Yamazaki",
  description = "山崎悠雅（yumazak）のポートフォリオ。エンジニアリングマネージャー / ソフトウェアエンジニア。",
} = Astro.props;

const pageTitle = title === "Yuma Yamazaki" ? title : `${title} | yumazak`;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link
      rel="alternate"
      type="text/markdown"
      href="https://raw.githubusercontent.com/yumazak/about/main/public/about.md"
    />
    <link rel="alternate" type="text/plain" href={`${base}llms.txt`} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="page">
      <slot />
    </div>
  </body>
</html>
