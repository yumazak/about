---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Base title="404">
  <header class="site-header">
    <h1>404</h1>
    <p class="lead">ページが見つかりませんでした。</p>
  </header>
  <main>
    <p>
      <a href={base}>← トップに戻る</a>
    </p>
  </main>
</Base>
