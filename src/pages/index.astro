---
import Base from "../layouts/Base.astro";
import { career, skillGroups } from "../data/career";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const askPrompt = encodeURIComponent(
  "次のMarkdownを読み、山崎悠雅（yumazak）の経歴・強み・現在の仕事を簡潔にまとめてください。 https://yumazak.github.io/about/ai.md",
);

const askServices = [
  { name: "ChatGPT", url: `https://chatgpt.com/?q=${askPrompt}` },
  { name: "Claude", url: `https://claude.ai/new?q=${askPrompt}` },
  { name: "Gemini", url: `https://gemini.google.com/app?q=${askPrompt}` },
  { name: "Perplexity", url: `https://www.perplexity.ai/search?q=${askPrompt}` },
];
---

<Base>
  <header class="site-header">
    <h1>Yuma Yamazaki</h1>
    <p class="lead">Engineering Manager @ PLEX / Software Engineer</p>
    <nav aria-label="目次">
      <a href="#about">About</a>
      <a href="#experience">Experience</a>
      <a href="#skills">Skills</a>
      <a href="#links">Links</a>
    </nav>
    <p class="ask">
      <span class="ask__label">Ask AI:</span>
      {askServices.map((service, index) => (
        <>
          {index > 0 && (
            <span class="ask__sep" aria-hidden="true">
              ·
            </span>
          )}
          <a href={service.url} target="_blank" rel="noopener noreferrer">
            {service.name}
          </a>
        </>
      ))}
    </p>
  </header>

  <main>
    <section id="about">
      <h2>About</h2>
      <p>
        関東在住のエンジニアです。シンプルなモノ、効率化すること、クリエイティブなことが好きです。
      </p>
      <p>
        HRテック企業の開発本部で、社内システム・データ基盤・AI を横断しています。Ruby on Rails /
        TypeScript / React のアプリケーション開発から、dbt・BigQuery のデータ基盤、Terraform・GitHub
        Actions のインフラ、LLM
        を活用した業務自動化まで、要件整理から運用定着まで一貫して担当しています。
      </p>
      <p>
        現在もリードエンジニアとして開発を続けながら、採用・人事評価・メンター・チーム運営にも従事しています。
      </p>
    </section>

    <section id="experience">
      <h2>Experience</h2>
      <ol class="experience">
        {career.map((item) => (
          <li>
            <span class="period">{item.period}</span>
            <div>
              <strong>{item.title}</strong>
              {item.role && <div class="role">{item.role}</div>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="skills">
      <h2>Skills</h2>
      <dl class="skills">
        {skillGroups.map((group) => (
          <>
            <dt>{group.label}</dt>
            <dd>{group.items.join(", ")}</dd>
          </>
        ))}
      </dl>
    </section>

    <section id="links">
      <h2>Links</h2>
      <ul class="links">
        <li>
          <a href="https://github.com/yumazak" target="_blank" rel="me noopener noreferrer">
            GitHub
          </a>
        </li>
        <li>
          <a href="https://x.com/yumazak" target="_blank" rel="me noopener noreferrer">
            X
          </a>
        </li>
        <li>
          <a href="https://dev-null.sh/@yumazak" target="_blank" rel="me noopener noreferrer">
            dev-null.sh
          </a>
        </li>
        <li>
          <a href={`${base}ai.md`}>AI profile (Markdown)</a>
        </li>
      </ul>
    </section>
  </main>
</Base>
