---
import Base from "../layouts/Base.astro";
import { career, skillGroups } from "../data/career";
import claudeIcon from "@lobehub/icons-static-svg/icons/claude.svg?raw";
import geminiIcon from "@lobehub/icons-static-svg/icons/gemini.svg?raw";
import grokIcon from "@lobehub/icons-static-svg/icons/grok.svg?raw";
import openaiIcon from "@lobehub/icons-static-svg/icons/openai.svg?raw";
import perplexityIcon from "@lobehub/icons-static-svg/icons/perplexity.svg?raw";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const about = [
  "関東在住のエンジニアです。シンプルなモノ、効率化すること、クリエイティブなことが好きです。",
  "HRテック企業の開発本部で、社内システム・データ基盤・AI を横断しています。Ruby on Rails / TypeScript / React のアプリケーション開発から、dbt・BigQuery のデータ基盤、Terraform・GitHub Actions のインフラ、LLM を活用した業務自動化まで、要件整理から運用定着まで一貫して担当しています。",
  "現在もリードエンジニアとして開発を続けながら、採用・人事評価・メンター・チーム運営にも従事しています。",
];

const aiProfile = [
  "山崎悠雅（Yuma Yamazaki / yumazak）のプロフィールです。以下の情報を踏まえて質問に答えてください。",
  "",
  "## About",
  about.join("\n\n"),
  "",
  "## Experience",
  ...career.map((item) => `- ${item.period}: ${item.title}${item.role ? ` — ${item.role}` : ""}`),
  "",
  "## Skills",
  ...skillGroups.map((group) => `- ${group.label}: ${group.items.join(", ")}`),
  "",
  "## Links",
  "- GitHub: https://github.com/yumazak",
  "- X: https://x.com/yumazak",
  "- dev-null.sh: https://dev-null.sh/@yumazak",
  "- 詳細: https://yumazak.github.io/about/ai.md",
].join("\n");

const aiPrompt = encodeURIComponent(aiProfile);

const aiServices = [
  { name: "ChatGPT", icon: openaiIcon, url: `https://chatgpt.com/?q=${aiPrompt}` },
  { name: "Claude", icon: claudeIcon, url: `https://claude.ai/new?q=${aiPrompt}` },
  { name: "Gemini", icon: geminiIcon, url: `https://www.google.com/search?udm=50&q=${aiPrompt}` },
  {
    name: "Perplexity",
    icon: perplexityIcon,
    url: `https://www.perplexity.ai/search?q=${aiPrompt}`,
  },
  { name: "Grok", icon: grokIcon, url: `https://grok.com/?q=${aiPrompt}` },
];
---

<Base>
  <header class="site-header">
    <h1>Yuma Yamazaki</h1>
    <p class="lead">Engineering Manager @ PLEX / Software Engineer</p>
    <nav aria-label="目次">
      <a href="#ask">Ask AI</a>
      <a href="#about">About</a>
      <a href="#experience">Experience</a>
      <a href="#skills">Skills</a>
      <a href="#links">Links</a>
    </nav>
  </header>

  <main>
    <section id="ask" class="ask-panel" aria-labelledby="ask-title">
      <div class="ask-panel__head">
        <h2 id="ask-title">Ask AI about me</h2>
        <p>About / Experience / Skills をまとめたプロンプトで、各AIに質問できます。</p>
      </div>
      <ul class="ai__actions">
        {aiServices.map((service) => (
          <li>
            <a class="ai__button" href={service.url} target="_blank" rel="noopener noreferrer">
              <span class="ai__icon" aria-hidden="true" set:html={service.icon} />
              <span class="ai__name">{service.name}</span>
              <span class="ai__arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="ask-panel__note">
        <a href={`${base}ai.md`}>詳細プロフィール（ai.md）</a>
      </p>
    </section>

    <section id="about">
      <h2>About</h2>
      {about.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </section>

    <section id="experience">
      <h2>Experience</h2>
      <ol class="experience">
        {career.map((item) => (
          <li>
            <span class="period">{item.period}</span>
            <div>
              <strong>{item.title}</strong>
              {item.role && <div class="role">{item.role}</div>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="skills">
      <h2>Skills</h2>
      <dl class="skills">
        {skillGroups.map((group) => (
          <>
            <dt>{group.label}</dt>
            <dd>{group.items.join(", ")}</dd>
          </>
        ))}
      </dl>
    </section>

    <section id="links">
      <h2>Links</h2>
      <ul class="links">
        <li>
          <a href="https://github.com/yumazak" target="_blank" rel="me noopener noreferrer">
            GitHub
          </a>
        </li>
        <li>
          <a href="https://x.com/yumazak" target="_blank" rel="me noopener noreferrer">
            X
          </a>
        </li>
        <li>
          <a href="https://dev-null.sh/@yumazak" target="_blank" rel="me noopener noreferrer">
            dev-null.sh
          </a>
        </li>
      </ul>
    </section>
  </main>
</Base>
